GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PORT=3001

# Local default: Gemini Developer API via GEMINI_API_KEY.
# Cloud Run: set true and use the runtime service account's ADC; do not inject a key.
GOOGLE_GENAI_USE_VERTEXAI=false

# Vertex model access uses GOOGLE_CLOUD_LOCATION=global for Gemini 3.7 Flash.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Local defaults. Vertex state is prepared but remains disabled until separately verified.
CONTEXTOPS_STATE_BACKEND=memory
CONTEXTOPS_TELEMETRY=console
CONTEXTOPS_CLOUD_REGISTRY=false
VERTEX_AGENT_ENGINE_ID=

# Set to the exact frontend origin only when the UI and agent run on different origins.
CONTEXTOPS_UI_ORIGIN=

# Public demo cost guard: /triage and /fleet/run share this global in-memory
# request window. Cloud Run max-instances must remain 1 for this guard.
CONTEXTOPS_TRIAGE_RATE_LIMIT=60
CONTEXTOPS_TRIAGE_RATE_WINDOW_MS=600000

# Hard ADK provider-call ceiling for one /fleet/run request. The fleet forces
# tool use, so this prevents a model/tool loop from spending without bound.
CONTEXTOPS_FLEET_MAX_LLM_CALLS=15

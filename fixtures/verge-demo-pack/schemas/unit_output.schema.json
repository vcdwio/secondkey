{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verge Unit Output",
  "type": "object",
  "required": [
    "status",
    "summary",
    "recommendations",
    "proposed_actions",
    "evidence",
    "confidence",
    "approval_required",
    "external_write",
    "trace_id"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "awaiting_approval",
        "needs_information",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "recommendations": {
      "type": "array"
    },
    "proposed_actions": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_reasons": {
      "type": "array"
    },
    "missing_information": {
      "type": "array"
    },
    "approval_required": {
      "type": "boolean"
    },
    "external_write": {
      "const": false
    },
    "trace_id": {
      "type": "string"
    }
  }
}
